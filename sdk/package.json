{
  "name": "replay-sdk",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Drop-in flight recorder for AI agent runs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmol/REPLAY.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/ratmol/REPLAY#readme",
  "bugs": {
    "url": "https://github.com/ratmol/REPLAY/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.7.0",
    "replay-shared": "workspace:*"
  }
}
