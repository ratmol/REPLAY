{
  "name": "replay-collector",
  "version": "0.0.1",
  "description": "Hono + Zod API that validates and stores agent run events in SQLite",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.0",
    "better-sqlite3": "^11.3.0",
    "@hono/node-server": "^1.13.0",
    "replay-shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0"
  }
}
